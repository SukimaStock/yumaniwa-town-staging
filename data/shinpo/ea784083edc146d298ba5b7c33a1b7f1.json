  "cover": "<figure><img src=\"../../assets/shinpo/yakitori-remake/cover.png\" alt=\"ゲームの中の焼き鳥を、焼き直したの元掲載画像\" fetchpriority=\"high\" width=\"1280\" height=\"670\"></figure>",
