  "cover": "<figure><img src=\"../../assets/shinpo/coffee-factory/cover.png\" alt=\"CoffeeFactoryの工場とコーヒー豆・水を運ぶトラック\" width=\"1280\" height=\"670\" fetchpriority=\"high\"></figure>",
